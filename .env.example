# WordRhythm Environment Configuration Example

# Application Port (Render will provide this automatically via $PORT)
PORT=8000

# Secret Key for JWT Token Generation (Render can generate this automatically)
SECRET_KEY=wordrhythm-super-secret-jwt-key-production-replace-me

# JWT Token Expiry in Minutes (Default: 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database URL
# Default SQLite (zero setup, auto-creates on startup):
DATABASE_URL=sqlite:///./wordrhythm.db

# Or PostgreSQL (e.g. Render / Supabase / Neon):
# DATABASE_URL=postgresql://user:password@host:5432/wordrhythm_db

# Or Microsoft SQL Server:
# DATABASE_URL=mssql+pymssql://sa:password@host:1433/WordRhythmDB
